# ════════════════════════════════════════════════════════════════
#  MeetOn Backend — Environment Variables
#  Copy to .env locally. On Render/Railway/Heroku set these in
#  the hosting dashboard — never commit a real .env file.
# ════════════════════════════════════════════════════════════════

# ── MongoDB ───────────────────────────────────────────────────
# Rotate your old password (rashisin07_db_user / meetOn123 was exposed)
MONGO_URI=mongodb+srv://<username>:<new_password>@cluster0.xxxxx.mongodb.net/meeton

# ── JWT ───────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_string
JWT_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────
PORT=8000
BASE_URL=http://localhost:8000
ALLOWED_ORIGIN=http://localhost:5173

# ── Google OAuth ──────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. APIs & Services → Credentials → Create OAuth 2.0 Client ID
# 3. Add your frontend URL to "Authorised JavaScript origins"
# 4. Paste the Client ID below (the backend only needs Client ID, not secret)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── STUN/TURN (Video calls) ───────────────────────────────────
# Free STUN: Google's public servers (already hardcoded as fallback in frontend)
# For production add a TURN server — Twilio, Metered.ca, or self-hosted coturn
# These are consumed by the FRONTEND (not backend) — put them in frontend .env too
VITE_STUN_SERVER=stun:stun.l.google.com:19302
VITE_TURN_SERVER=turn:your.turn.server:3478
VITE_TURN_USERNAME=your_turn_username
VITE_TURN_CREDENTIAL=your_turn_password
